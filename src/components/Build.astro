---
// The plan, drawn: one picture of our own studio that builds itself as the reader goes through
// the phases. Now: only the studio stands, the rest is a pencil plan. Next: the client work
// around it is built and lit. After scale: the academy is built too. The picture is stuck to
// the top of the screen (beside the phases from 900px) and shows the stage of the phase being
// read. Phases live in src/data/blueprint.ts, the pictures in public/art/plan-{1,2,3}-*.webp.
import { PHASES } from '../data/blueprint';
import { translator, type Lang } from '../i18n';
import { asset } from '../lib/util';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = translator(lang);

const stages = PHASES.map((_, i) => {
  const k = i + 1;
  return {
    k,
    src: asset(`/art/plan-${k}-1600.webp`),
    srcset: `${asset(`/art/plan-${k}-800.webp`)} 800w, ${asset(`/art/plan-${k}-1600.webp`)} 1600w`,
  };
});
---

<div class="build" data-build>
  <div class="build__art" aria-hidden="true">
    {
      stages.map((s) => (
        <img
          class="build__stage"
          data-stage={s.k}
          src={s.src}
          srcset={s.srcset}
          sizes="(min-width: 900px) min(54vw, 780px), 100vw"
          width="1600"
          height="1200"
          alt=""
          loading="lazy"
          decoding="async"
        />
      ))
    }
  </div>

  <ol class="phases" role="list">
    {
      PHASES.map((p, i) => (
        <li class:list={['phase', { 'phase--now': i === 0 }]} data-phase={i + 1}>
          <span class="tag">{t(p.when)}</span>
          <h3 class="phase__title">
            <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            {t(p.title)}
          </h3>
          <p class="phase__text">{t(p.text)}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .build {
    display: grid;
  }

  /* Phones: the picture runs edge to edge and stays under the page header while the phases
     scroll beneath it. Each stage lies over the one before, so going back never shows black. */
  .build__art {
    position: sticky;
    top: 56px;
    z-index: 1;
    margin-inline: calc(var(--gutter) * -1);
    aspect-ratio: 4 / 3;
    background: var(--bg);
  }

  .build__art::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 36px;
    background: linear-gradient(to top, var(--bg), transparent);
  }

  .build__stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }

  .build__stage[data-stage='1'],
  .build[data-at='2'] .build__stage[data-stage='2'],
  .build[data-at='3'] .build__stage[data-stage='2'],
  .build[data-at='3'] .build__stage[data-stage='3'] {
    opacity: 1;
  }

  /* Without the script the finished picture shows. */
  .build:not([data-at]) .build__stage[data-stage='3'] {
    opacity: 1;
    transition: none;
  }

  .build .phases {
    grid-template-columns: none;
  }

  .build .phase {
    min-height: 34svh;
    transition: opacity 0.5s ease;
  }

  .build .phase:last-child {
    min-height: 0;
    padding-bottom: 18svh;
  }

  .build[data-at] .phase:not(.is-on) {
    opacity: 0.38;
  }

  .build[data-at] .phase.is-on {
    border-top-color: var(--accent);
  }

  /* From 900px: the phases on the left, the picture beside them in the middle of the screen. */
  @media (min-width: 900px) {
    .build {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(40px, 6vw, 110px);
      align-items: start;
    }

    .build__art {
      grid-column: 2;
      grid-row: 1;
      top: max(80px, calc(50vh - 21vw));
      margin: 0;
      overflow: hidden;
      border-radius: 14px;
    }

    .build__art::after {
      display: none;
    }

    .build .phases {
      grid-column: 1;
      grid-row: 1;
    }

    .build .phase {
      min-height: 52vh;
    }

    .build .phase:last-child {
      padding-bottom: 30px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .build__stage,
    .build .phase {
      transition: none;
    }
  }
</style>

<script>
  // The phase being read is the last one whose top has passed a line on the screen: 62% of its
  // height on phones (below the picture stuck at the top), 42% from 900px (the picture is beside
  // the phases). The picture shows that phase's stage.
  const build = document.querySelector<HTMLElement>('[data-build]');
  if (build) {
    const phases = [...build.querySelectorAll<HTMLElement>('[data-phase]')];
    const beside = window.matchMedia('(min-width: 900px)');
    let waiting = false;
    const place = () => {
      waiting = false;
      const line = window.innerHeight * (beside.matches ? 0.42 : 0.62);
      let at = 1;
      for (const p of phases) if (p.getBoundingClientRect().top < line) at = Number(p.dataset.phase);
      if (build.dataset.at !== String(at)) {
        build.dataset.at = String(at);
        for (const p of phases) p.classList.toggle('is-on', p.dataset.phase === String(at));
      }
    };
    const ask = () => {
      if (waiting) return;
      waiting = true;
      requestAnimationFrame(place);
    };
    window.addEventListener('scroll', ask, { passive: true });
    window.addEventListener('resize', ask);
    place();
  }
</script>
