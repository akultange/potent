---
import type { CollectionEntry } from 'astro:content';
import { SERVICES } from '../data/services';
import { hue, initials } from '../lib/util';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
const d = person.data;
const isFounder = d.group === 'founder';

const LINK_LABELS = {
  linkedin: 'LinkedIn',
  portfolio: 'Portfolio',
  behance: 'Behance',
  instagram: 'Instagram',
  github: 'GitHub',
} as const;

const links = (Object.keys(LINK_LABELS) as (keyof typeof LINK_LABELS)[])
  .filter((k) => d.links[k])
  .map((k) => ({ label: LINK_LABELS[k], href: d.links[k]! }));

const serviceName = (id: string) => SERVICES.find((s) => s.id === id)?.name ?? id;
const isEmpty = !d.bio && d.services.length === 0 && d.projects.length === 0;
---

<article
  class:list={['person', { 'person--founder': isFounder }]}
  id={person.id}
  data-services={d.services.join(' ')}
>
  <header class="person__head">
    <div class="avatar" style={`--hue:${hue(d.name)}`} aria-hidden="true">{initials(d.name)}</div>
    <div class="person__id">
      <h3>{d.name}</h3>
      <p class="person__title">{d.title}</p>
      {d.location && <p class="person__loc">{d.location}</p>}
    </div>
  </header>

  {d.bio && <p class="person__bio">{d.bio}</p>}
  {isEmpty && <p class="pending">Profile coming soon.</p>}

  {
    links.length > 0 && (
      <ul class="links" aria-label={`${d.name} online`}>
        {links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener noreferrer">
              {l.label}
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    d.services.length > 0 && (
      <ul class="chips" aria-label="Services">
        {d.services.map((s) => (
          <li class="chip">{serviceName(s)}</li>
        ))}
      </ul>
    )
  }

  {
    d.projects.length > 0 && (
      <section class="projects" aria-label={`${d.name}'s projects`}>
        <h4 class="label">Projects</h4>
        <ul>
          {d.projects.map((p) => (
            <li>
              <p class="proj-name">
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener noreferrer">
                    {p.name}
                    <span aria-hidden="true"> ↗</span>
                  </a>
                ) : (
                  p.name
                )}
              </p>
              <p class="proj-meta">
                {[p.client && p.client !== p.name ? p.client : null, p.type].filter(Boolean).join(' · ')}
              </p>
              <p class="proj-summary">{p.summary}</p>
              {p.role && (
                <p class="proj-role">
                  <span>Role</span> {p.role}
                </p>
              )}
              {p.caseStudy && (
                <a class="proj-case" href={p.caseStudy} target="_blank" rel="noopener noreferrer">
                  Case study <span aria-hidden="true">↗</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</article>
