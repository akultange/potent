---
// One person, face first: their photo (or initials), name, role, the brands they have worked
// for and their links. Founders get a larger card with their headline numbers.
import { translator, type Lang, type LocalPerson } from '../i18n';
import { asset, hue, initials } from '../lib/util';

interface Props {
  /** A person from src/content/people/, already in the page's language (see localPerson). */
  person: LocalPerson;
  lang?: Lang;
}

const { person, lang = 'en' } = Astro.props;
const t = translator(lang);
const d = person.data;
const isFounder = d.group === 'founder';

// Brands behind their work, featured projects first; brand names stay as they are.
const clients = [
  ...new Set(
    [...d.projects.filter((p) => p.featured), ...d.projects.filter((p) => !p.featured)]
      .map((p) => p.en.client)
      .filter((c): c is string => Boolean(c)),
  ),
].slice(0, isFounder ? 4 : 2);
const facts = isFounder ? d.facts.slice(0, 3) : [];

const LINK_LABELS = {
  linkedin: 'LinkedIn',
  portfolio: t('Portfolio'),
  behance: 'Behance',
  instagram: 'Instagram',
  github: 'GitHub',
} as const;
const links = (Object.keys(LINK_LABELS) as (keyof typeof LINK_LABELS)[])
  .filter((k) => d.links[k])
  .map((k) => ({ label: LINK_LABELS[k], href: d.links[k]! }));
---

<article class:list={['person', isFounder ? 'person--founder' : 'person--member']} id={person.id}>
  <div class="person__face" style={`--hue:${hue(d.en.name)}`}>
    {
      d.photo ? (
        <img src={asset(d.photo)} alt={d.name} loading="lazy" decoding="async" />
      ) : (
        <span class="person__initials" aria-hidden="true">
          {initials(d.name)}
        </span>
      )
    }
  </div>

  <div class="person__body">
    <h4 class="person__name">{d.name}</h4>
    <p class="person__title">{d.title}</p>

    {
      facts.length > 0 && (
        <dl class="facts">
          {facts.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      clients.length > 0 && (
        <ul class="brands" aria-label={t('Worked for')}>
          {clients.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      )
    }

    {
      links.length > 0 && (
        <ul class="links" aria-label={t('{name} online', { name: d.name })}>
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label}
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
