---
// One person, the way a profile reads on Awwwards: a round black-and-white portrait, the name,
// the role. Founders get the full profile (city, one plain line, their three numbers in a framed
// row, the brands they worked for, round link buttons); specialists get a compact row with one
// number. Styles: "the team" in src/styles/global.css.
import { translator, type Lang, type LocalPerson } from '../i18n';
import { asset, initials, keep } from '../lib/util';

interface Props {
  /** A person from src/content/people/, already in the page's language (see localPerson). */
  person: LocalPerson;
  lang?: Lang;
}

const { person, lang = 'en' } = Astro.props;
const t = translator(lang);
const d = person.data;
const isFounder = d.group === 'founder';

// Brands behind their featured work; brand names stay as they are.
const clients = isFounder
  ? [
      ...new Set(
        d.projects
          .filter((p) => p.featured)
          .map((p) => p.en.client)
          .filter((c): c is string => Boolean(c)),
      ),
    ].slice(0, 4)
  : [];
const facts = d.facts.slice(0, isFounder ? 3 : 1);

// Round buttons with a small mark each, like the profile links on Awwwards.
const LINKS = {
  linkedin: { label: 'LinkedIn', mark: 'in' },
  portfolio: { label: t('Portfolio'), mark: 'web' },
  behance: { label: 'Behance', mark: 'Bē' },
  instagram: { label: 'Instagram', mark: 'camera' },
  github: { label: 'GitHub', mark: '</>' },
} as const;
const links = (Object.keys(LINKS) as (keyof typeof LINKS)[])
  .filter((k) => d.links[k])
  .map((k) => ({ ...LINKS[k], href: d.links[k]! }));
const photo = d.photo ? asset(d.photo) : null;

/** The mark inside a round link button: two plain drawings, otherwise short letters. */
function mark(m: string): string {
  if (m === 'web') {
    return '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10" cy="10" r="7.5"/><path d="M2.5 10h15M10 2.5c2.2 2.3 3.2 4.8 3.2 7.5s-1 5.2-3.2 7.5M10 2.5C7.8 4.8 6.8 7.3 6.8 10s1 5.2 3.2 7.5"/></svg>';
  }
  if (m === 'camera') {
    return '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="14" height="14" rx="4"/><circle cx="10" cy="10" r="3.2"/><circle cx="14.2" cy="5.8" r="0.6" fill="currentColor"/></svg>';
  }
  return `<span aria-hidden="true">${m.replace('<', '&lt;').replace('>', '&gt;')}</span>`;
}
---

{
  isFounder ? (
    <article class="profile" id={person.id} data-reveal>
      <div class="profile__head">
        {photo ? (
          <img class="avatar avatar--lg" src={photo} alt={d.name} width="120" height="120" loading="lazy" decoding="async" />
        ) : (
          <span class="avatar avatar--lg avatar--initials" aria-hidden="true">
            {initials(d.name)}
          </span>
        )}
        <div>
          <h4 class="profile__name">{d.name}</h4>
          <p class="profile__role">{keep(d.title)}</p>
          {d.location && <p class="profile__where">{d.location}</p>}
        </div>
      </div>

      {d.line && <p class="profile__line">{d.line}</p>}

      {facts.length > 0 && (
        <dl class="profile__stats">
          {facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )}

      <div class="profile__foot">
        {clients.length > 0 && (
          <p class="profile__brands">
            <span>{t('Worked for')}</span> {clients.join(', ')}
          </p>
        )}
        {links.length > 0 && (
          <ul class="icons" aria-label={t('{name} online', { name: d.name })}>
            {links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={`${l.label}: ${d.name}`} title={l.label}>
                  <Fragment set:html={mark(l.mark)} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </article>
  ) : (
    <article class="member" id={person.id} data-reveal>
      {photo ? (
        <img class="avatar avatar--md" src={photo} alt={d.name} width="60" height="60" loading="lazy" decoding="async" />
      ) : (
        <span class="avatar avatar--md avatar--initials" aria-hidden="true">
          {initials(d.name)}
        </span>
      )}
      <div class="member__who">
        <h4 class="member__name">{d.name}</h4>
        <p class="member__role">{keep(d.title)}</p>
        {facts[0] && (
          <p class="member__fact">
            <b>{facts[0].value}</b> {facts[0].label}
          </p>
        )}
      </div>
      {links.length > 0 && (
        <ul class="icons icons--sm" aria-label={t('{name} online', { name: d.name })}>
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={`${l.label}: ${d.name}`} title={l.label}>
                <Fragment set:html={mark(l.mark)} />
              </a>
            </li>
          ))}
        </ul>
      )}
    </article>
  )
}

