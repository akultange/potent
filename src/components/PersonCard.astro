---
// One person: their work in pictures, then name, title, a few numbers and links. No paragraphs;
// bios and project write-ups stay in the YAML files.
import Mosaic from './Mosaic.astro';
import { translator, type Lang, type LocalPerson } from '../i18n';
import { hue, initials } from '../lib/util';

interface Props {
  /** A person from src/content/people/, already in the page's language (see localPerson). */
  person: LocalPerson;
  lang?: Lang;
  /** Heading level of the name: 3 straight under a section title, 4 under a team name. */
  level?: 3 | 4;
}

const { person, lang = 'en', level = 3 } = Astro.props;
const t = translator(lang);
const d = person.data;
const isFounder = d.group === 'founder';
const Name = level === 4 ? 'h4' : 'h3';

// Featured projects with a picture, in YAML order: up to six for a founder, three in the network.
// Someone without pictures yet shows their featured projects as lettered tiles instead.
const featured = d.projects.filter((p) => p.featured);
const pictured = featured.filter((p) => p.image);
const tiles = (pictured.length > 0 ? pictured : featured).slice(0, isFounder ? 6 : 3);
const facts = d.facts.slice(0, isFounder ? 3 : 2);

const LINK_LABELS = {
  linkedin: 'LinkedIn',
  portfolio: t('Portfolio'),
  behance: 'Behance',
  instagram: 'Instagram',
  github: 'GitHub',
} as const;

const links = (Object.keys(LINK_LABELS) as (keyof typeof LINK_LABELS)[])
  .filter((k) => d.links[k])
  .map((k) => ({ label: LINK_LABELS[k], href: d.links[k]! }));
const isEmpty = d.projects.length === 0 && d.facts.length === 0;
---

<article class:list={['person', isFounder ? 'person--founder' : 'person--network']} id={person.id}>
  {tiles.length > 0 && <Mosaic projects={tiles} label={t('Work by {name}', { name: d.name })} />}

  <div class="person__body">
    <header class="person__head">
      <span class="avatar" style={`--hue:${hue(d.en.name)}`} aria-hidden="true">{initials(d.name)}</span>
      <div>
        <Name class="person__name">{d.name}</Name>
        <p class="person__title">{d.title}</p>
      </div>
    </header>

    {isEmpty && <p class="pending">{t('Profile coming soon.')}</p>}

    {
      facts.length > 0 && (
        <dl class="facts">
          {facts.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      links.length > 0 && (
        <ul class="links" aria-label={t('{name} online', { name: d.name })}>
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label}
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
