---
// How the team works, told as the path of one order (Luka, 2026-11-26): Giorgi and Luka bring the
// clients themselves (they run our social media and test ads on different audiences, with the
// sales and marketing people), take the order, hand the work to the network (partner teams join
// when there is a lot of it), check every result and send back what is below the bar; the client
// gets the finished work. Faces, not boxes: the reader sees who does what.
// The founders' roles and the sales roles live in STRUCTURE (src/data/blueprint.ts).
import { counted, translator, type Lang, type LocalPerson } from '../i18n';
import { asset, hue, initials } from '../lib/util';

interface Head {
  id: string;
  name: string;
  role: string;
  photo: string | null;
}

interface Props {
  lang?: Lang;
  /** Luka and Giorgi, with their roles. */
  heads: Head[];
  /** The specialists shown on the page. */
  specialists: LocalPerson[];
  /** How many more people the network brings (the network card's counts added up). */
  more: number;
  /** The sales and marketing roles. */
  sales: readonly string[];
}

const { lang = 'en', heads, specialists, more, sales } = Astro.props;
const t = translator(lang);

const crowd = specialists.map((p) => ({
  name: p.data.name,
  photo: p.data.photo ? asset(p.data.photo) : null,
  short: initials(p.data.en.name),
  hue: hue(p.data.en.name),
}));
const names = heads.map((h) => h.name.split(' ')[0]);
const n = specialists.length;
const onPage = lang === 'ru' ? `${n} ${counted(lang, n, 'specialists')}` : `${n} specialists`;
---

<ol class="flow" role="list" data-flow>
  <li class="flow__step flow__step--us">
    <span class="flow__n" aria-hidden="true">01</span>
    <div class="flow__body">
      <h3 set:html={t('<em>{a} and {b}</em> bring the clients', { a: names[0]!, b: names[1]! })} />
      <p>{t('They run our social media themselves, launch ads to different audiences and see what works. With them:')}</p>
      <ul class="flow__roles" role="list">
        {sales.map((r) => <li>{t(r)}</li>)}
      </ul>
    </div>
  </li>

  <li class="flow__step flow__step--us">
    <span class="flow__n" aria-hidden="true">02</span>
    <div class="flow__body">
      <h3 set:html={t('<em>{a} and {b}</em> take it', { a: names[0]!, b: names[1]! })} />
      <p>{t('They agree what will be done, by when and for how much, choose who will do it and set the bar.')}</p>
      <div class="flow__duo">
        {
          heads.map((h) => (
            <a href={`#${h.id}`}>
              {h.photo && <img src={h.photo} alt="" width="56" height="56" loading="lazy" decoding="async" />}
              <span>
                <b>{h.name}</b>
                {t(h.role)}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </li>

  <li class="flow__step">
    <span class="flow__n" aria-hidden="true">03</span>
    <div class="flow__body">
      <h3>{t('Our network does the work')}</h3>
      <p>
        {
          t(
            'Team leads and their people: {a} on this page and {b} more from our circle in Tbilisi. When there is a lot of work, partner teams join.',
            { a: onPage, b: String(more) },
          )
        }
      </p>
      <div class="flow__crowd">
        {
          crowd.map((c) =>
            c.photo ? (
              <img src={c.photo} alt={c.name} title={c.name} width="44" height="44" loading="lazy" decoding="async" />
            ) : (
              <span class="flow__face" style={`--hue:${c.hue}`} title={c.name}>
                <span aria-hidden="true">{c.short}</span>
                <span class="sr-only">{c.name}</span>
              </span>
            ),
          )
        }
        <span class="flow__face flow__face--more">+{more}</span>
      </div>
    </div>
  </li>

  <li class="flow__step flow__step--us">
    <span class="flow__n" aria-hidden="true">04</span>
    <div class="flow__body">
      <h3 set:html={t('<em>{a} and {b}</em> check it', { a: names[0]!, b: names[1]! })} />
      <p>{t('Every result, before the client sees it.')}</p>
      <p class="flow__back">
        <span aria-hidden="true">↺</span>
        {t('Anything below the bar goes back to step 03 for fixes.')}
      </p>
    </div>
  </li>

  <li class="flow__step flow__step--end">
    <span class="flow__n" aria-hidden="true">05</span>
    <div class="flow__body">
      <h3>{t('The client gets it')}</h3>
      <p>{t('Finished work at our level, and support every month after launch.')}</p>
    </div>
  </li>
</ol>

<style>
  /* Phones: the steps run down a line on the left, an orange point travels it like the order.
     From 900px they run across in one row. */
  .flow {
    --mark: 44px;
    position: relative;
    display: grid;
    gap: 30px;
  }

  .flow::before,
  .flow::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  /* the line */
  .flow::before {
    top: calc(var(--mark) / 2);
    bottom: calc(var(--mark) / 2);
    left: calc(var(--mark) / 2 - 0.5px);
    width: 1px;
    background: linear-gradient(var(--line), var(--accent) 55%, var(--line));
  }

  /* the travelling point */
  .flow::after {
    top: calc(var(--mark) / 2 - 5px);
    left: calc(var(--mark) / 2 - 5px);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow:
      0 0 0 4px rgb(255 90 31 / 0.18),
      0 0 18px 4px rgb(255 90 31 / 0.55);
    opacity: 0;
  }

  .flow.is-live::after {
    animation: flow-down 7s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @keyframes flow-down {
    0% {
      top: calc(var(--mark) / 2 - 5px);
      opacity: 0;
    }

    6%,
    90% {
      opacity: 1;
    }

    100% {
      top: calc(100% - var(--mark) / 2 - 5px);
      opacity: 0;
    }
  }

  .flow__step {
    position: relative;
    display: grid;
    grid-template-columns: var(--mark) minmax(0, 1fr);
    column-gap: 18px;
    align-content: start;
    align-items: start;
  }

  .flow__n {
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--mark);
    height: var(--mark);
    border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: 50%;
    background: var(--bg);
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
    color: var(--muted);
  }

  /* the two steps that are Luka and Giorgi's */
  .flow__step--us .flow__n {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .flow__step--end .flow__n {
    border-color: var(--accent);
    color: var(--accent);
  }

  .flow__body {
    padding-top: 6px;
  }

  .flow__body h3 {
    font-size: clamp(25px, 7vw, 34px);
    line-height: 1;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .flow__body h3 :global(em) {
    color: var(--accent);
  }

  .flow__body p {
    max-width: 38ch;
    margin-top: 10px;
    font-size: 16.5px;
    line-height: 1.45;
    color: var(--muted);
  }

  .flow__roles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .flow__roles li {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 14px;
    color: var(--ink);
  }

  .flow__duo {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }

  .flow__duo a {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    font-size: 14px;
    line-height: 1.3;
    color: var(--muted);
  }

  .flow__duo img {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px var(--accent);
  }

  .flow__duo span {
    display: flex;
    flex-direction: column;
  }

  .flow__duo b {
    font-size: 17px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  /* the network: faces overlapping, then how many more */
  .flow__crowd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 16px;
    padding-left: 8px;
  }

  .flow__crowd > * {
    width: 40px;
    height: 40px;
    margin-left: -9px;
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--bg);
  }

  .flow__crowd img {
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
  }

  .flow__face {
    display: grid;
    place-items: center;
    background: hsl(var(--hue) 22% 22%);
    font-size: 13px;
    font-weight: 600;
    color: hsl(var(--hue) 30% 82%);
  }

  .flow__face--more {
    background: var(--accent);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-ink);
  }

  .flow__body .flow__back {
    display: flex;
    gap: 8px;
    align-items: baseline;
    color: var(--accent);
  }

  .flow__back span {
    font-size: 19px;
    line-height: 1;
  }

  @media (min-width: 900px) {
    .flow {
      --gap: clamp(18px, 2vw, 32px);
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--gap);
    }

    .flow::before {
      top: calc(var(--mark) / 2 - 0.5px);
      bottom: auto;
      left: calc(var(--mark) / 2);
      right: calc((100% - 4 * var(--gap)) / 5 - var(--mark) / 2);
      width: auto;
      height: 1px;
      background: linear-gradient(90deg, var(--line), var(--accent) 55%, var(--line));
    }

    .flow.is-live::after {
      animation-name: flow-across;
    }

    @keyframes flow-across {
      0% {
        left: calc(var(--mark) / 2 - 5px);
        opacity: 0;
      }

      6%,
      90% {
        opacity: 1;
      }

      100% {
        left: calc(100% - (100% - 4 * var(--gap)) / 5 + var(--mark) / 2 - 5px);
        opacity: 0;
      }
    }

    .flow__step {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 20px;
    }

    .flow__body {
      padding-top: 0;
    }

    .flow__body h3 {
      font-size: clamp(24px, 2.2vw, 32px);
    }

    .flow__body p {
      font-size: 15.5px;
    }

    .flow__crowd > * {
      width: 34px;
      height: 34px;
      margin-left: -8px;
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow.is-live::after {
      animation: none;
    }
  }
</style>

<script>
  // The point travels only while the steps are on screen.
  const flow = document.querySelector<HTMLElement>('[data-flow]');
  if (flow && 'IntersectionObserver' in window) {
    new IntersectionObserver((entries) => {
      for (const entry of entries) flow.classList.toggle('is-live', entry.isIntersecting);
    }).observe(flow);
  }
</script>
