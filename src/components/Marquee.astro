---
// The work, moving: two rows of project pictures sliding in opposite directions, so the page
// shows how much has been made before anyone reads a word. Hover or the button pauses it; with
// reduced motion it stands still and scrolls by hand.
import { translator, type Lang, type LocalPerson } from '../i18n';
import { thumbOf } from '../lib/util';

interface Props {
  /** Everyone on the page, in the page's language. */
  people: LocalPerson[];
  lang?: Lang;
}

const { people, lang = 'en' } = Astro.props;
const t = translator(lang);

// Every project with a picture, taking turns person by person so no one fills a whole row.
// The small 640 x 400 copies load right away (at low priority): lazy loading never fires for
// pictures that slide into view on a moving track.
const lists = people.map((person) =>
  person.data.projects
    .filter((p) => p.image)
    .map((p) => ({ src: thumbOf(p.image!), name: p.name, client: p.client && !p.name.includes(p.client) ? p.client : null })),
);
const items: (typeof lists)[number] = [];
const longest = Math.max(0, ...lists.map((l) => l.length));
for (let i = 0; i < longest; i++) for (const list of lists) if (list[i]) items.push(list[i]);
const half = Math.ceil(items.length / 2);
const rows = [items.slice(0, half), items.slice(half)];
---

<div class="marquee" data-marquee>
  {
    rows.map((row, r) => (
      <div class:list={['marquee__track', { 'marquee__track--back': r === 1 }]}>
        {[0, 1].map((copy) => (
          <ul class="marquee__row" aria-hidden={copy === 1 ? 'true' : undefined}>
            {row.map((p) => (
              <li class="marquee__item">
                <img src={p.src} alt="" width="640" height="400" fetchpriority="low" decoding="async" />
                <span class="marquee__cap">
                  {p.name}
                  {p.client && <small> · {p.client}</small>}
                </span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    ))
  }
  <button class="marquee__pause" type="button" data-pause={t('Pause')} data-play={t('Play')} hidden>
    {t('Pause')}
  </button>
</div>

<script>
  // Moving pictures need a way to stop them (and none at all with reduced motion).
  for (const box of document.querySelectorAll<HTMLElement>('[data-marquee]')) {
    const button = box.querySelector<HTMLButtonElement>('.marquee__pause');
    if (!button || window.matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    button.hidden = false;
    button.addEventListener('click', () => {
      const paused = box.toggleAttribute('data-paused');
      button.textContent = (paused ? button.dataset.play : button.dataset.pause) ?? '';
    });
  }
</script>
