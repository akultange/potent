---
import '../styles/fonts.css';
import '../styles/global.css';
import interLatin from '../assets/fonts/inter-tight-latin.woff2?url';
import interCyrillic from '../assets/fonts/inter-tight-cyrillic.woff2?url';
import { LANGS, homePath, localSite, type Lang } from '../i18n';
import { asset } from '../lib/util';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}

const { lang = 'en' } = Astro.props;
const site = localSite(lang);
const { title = `${site.name} | ${site.tagline}`, description = site.description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0c" />
    <!-- iPhones turn long numbers such as "$10 000–50 000" into phone links; prices are not phone numbers. -->
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <!-- lets the page hide things until they scroll into view, only when scripts run -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:url" content={new URL(homePath(lang), Astro.site)} />
    <!-- the picture messengers show when the link is sent to someone -->
    <meta property="og:image" content={new URL(asset('/og.jpg'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(homePath(l), Astro.site)} />)}
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    {lang === 'ru' && <link rel="preload" as="font" type="font/woff2" href={interCyrillic} crossorigin />}
  </head>
  <body>
    <slot />
  </body>
</html>
