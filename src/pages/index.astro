---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import Scope from '../components/Scope.astro';
import { SITE } from '../data/site';
import {
  LANGS,
  LANG_LABELS,
  counted,
  homePath,
  localPerson,
  localServices,
  localSite,
  projectCount,
  translator,
  type Lang,
} from '../i18n';
import { asset, hue, initials } from '../lib/util';

// This file is the page in both languages: "/" renders it as is (English), and
// src/pages/ru/index.astro renders it with lang="ru". Text goes through t(): it is written here
// in English and looked up in src/i18n/ru.ts for the Russian page.
interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = translator(lang);
const site = localSite(lang);

const ruTexts = new Map(lang === 'ru' ? (await getCollection('peopleRu')).map((e) => [e.id, e.data]) : []);
const people = (await getCollection('people'))
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name))
  .map((p) => localPerson(p, ruTexts.get(p.id)));
const founders = people.filter((p) => p.data.group === 'founder');
const network = people.filter((p) => p.data.group === 'network');

const projects = people.flatMap((person) => person.data.projects.map((project) => ({ ...project, person })));
// Selected work: featured projects with a screenshot, interleaved person by person so the
// grid reads as a network; then featured ones without a screenshot; then the rest (only shown
// when a service filter is active).
const featured = projects.filter((p) => p.featured);
const byPerson = new Map<string, typeof projects>();
for (const p of featured.filter((p) => p.image)) {
  byPerson.set(p.person.id, [...(byPerson.get(p.person.id) ?? []), p]);
}
const interleaved: typeof projects = [];
const longest = Math.max(0, ...[...byPerson.values()].map((l) => l.length));
for (let i = 0; i < longest; i++) {
  for (const list of byPerson.values()) if (list[i]) interleaved.push(list[i]);
}
const work = [...interleaved, ...featured.filter((p) => !p.image), ...projects.filter((p) => !p.featured)];

const services = localServices(lang).map((s) => ({
  ...s,
  people: people.filter((p) => (p.data.services as string[]).includes(s.id)),
  projectCount: projects.filter((p) => (p.services as string[]).includes(s.id)).length,
})).filter((s) => s.people.length > 0);

const rank = (c: string) => {
  const i = SITE.clientOrder.indexOf(c);
  return i === -1 ? SITE.clientOrder.length : i;
};
const clients = [...new Set(projects.filter((p) => p.featured && p.en.client).map((p) => p.en.client!))].sort(
  (a, b) => rank(a) - rank(b),
);
const matrixPeople = people.filter((p) => p.data.services.length > 0);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base lang={lang}>
  <header class="site-header">
    <div class="container">
      <a class="wordmark" href="#top"><i aria-hidden="true"></i>{site.name}</a>
      <nav class="nav" aria-label={t('Sections')}>
        <a href="#services">{t('Services')}</a>
        <a href="#who-does-what">{t('Who does what')}</a>
        <a href="#people">{t('People')}</a>
        <a href="#work">{t('Work')}</a>
        <span class="lang" role="group" aria-label={t('Language')}>
          {
            LANGS.map((l) =>
              l === lang ? (
                <span aria-current="true">{LANG_LABELS[l]}</span>
              ) : (
                <a href={homePath(l)} hreflang={l} lang={l}>
                  {LANG_LABELS[l]}
                </a>
              ),
            )
          }
        </span>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="container">
        <p class="eyebrow">{t('Design & engineering agency · {city}', { city: site.city })}</p>
        <h1 set:html={t('Product, brand and engineering, from <em>one senior team.</em>')} />
        <p class="lede">
          {
            t(
              "{name} pairs a founder-led product design practice with a network of specialists in Tbilisi. Between us, we've designed and built for banks, regulators, retailers and consumer brands.",
              { name: site.name },
            )
          }
        </p>
        <dl class="stats">
          <div class="stat"><dt>{counted(lang, people.length, 'people')}</dt><dd>{people.length}</dd></div>
          <div class="stat"><dt>{counted(lang, services.length, 'services')}</dt><dd>{services.length}</dd></div>
          <div class="stat"><dt>{counted(lang, projects.length, 'projects')}</dt><dd>{projects.length}</dd></div>
        </dl>
        {
          clients.length > 0 && (
            <div class="clients">
              <p class="label">{t('Work for')}</p>
              <ul>
                {clients.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    <Scope lang={lang} people={people} />

    <section class="section" id="services" aria-labelledby="services-title">
      <div class="container">
        <div class="section-head">
          <h2 id="services-title" set:html={t('What we <em>do</em>')} />
          <p>
            {
              t(
                'Every service is backed by someone in the network who has already done it, with the projects to prove it.',
              )
            }
          </p>
        </div>
        <div class="services">
          {
            services.map((s, i) => (
              <article class="service">
                <p class="service__num">{pad(i + 1)}</p>
                <h3>{s.name}</h3>
                <p class="service__blurb">{s.blurb}</p>
                <footer>
                  <ul class="faces" aria-label={t('Delivered by')}>
                    {s.people.map((p) => (
                      <li>
                        <a href={`#${p.id}`} title={p.data.name}>
                          <span class="avatar avatar--sm" style={`--hue:${hue(p.data.en.name)}`} aria-hidden="true">
                            {initials(p.data.name)}
                          </span>
                          <span class="face-name">{p.data.name}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  {s.projectCount > 0 && (
                    <a class="service__work" href="#work" data-goto-filter={s.id}>
                      {projectCount(lang, s.projectCount)} →
                    </a>
                  )}
                </footer>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="who-does-what" aria-labelledby="matrix-title">
      <div class="container">
        <div class="section-head">
          <h2 id="matrix-title" set:html={t('Who does <em>what</em>')} />
          <p>{t('Each person and the services they can lead.')}</p>
        </div>
        <div class="matrix-wrap" tabindex="0" role="region" aria-labelledby="matrix-title">
          <table class="matrix">
            <thead>
              <tr>
                <th scope="col" class="matrix__corner">{t('Person')}</th>
                {services.map((s) => <th scope="col">{s.short}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                matrixPeople.map((p) => (
                  <tr>
                    <th scope="row">
                      <a href={`#${p.id}`}>{p.data.name}</a>
                      <span>{p.data.title}</span>
                    </th>
                    {services.map((s) =>
                      (p.data.services as string[]).includes(s.id) ? (
                        <td>
                          <span class="dot" role="img" aria-label={t('Yes')} />
                        </td>
                      ) : (
                        <td>
                          <span class="sr-only">{t('No')}</span>
                        </td>
                      ),
                    )}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section" id="people" aria-labelledby="people-title">
      <div class="container">
        <div class="section-head">
          <h2 id="people-title" set:html={t('The <em>people</em>')} />
          <p>{t('Founders and the specialists we bring in, with the work each of them has done.')}</p>
        </div>

        <h3 class="label group-label">{t('Founders')}</h3>
        <div class="people-grid people-grid--founders">
          {founders.map((p) => <PersonCard person={p} lang={lang} />)}
        </div>

        <h3 class="label group-label">{t('Network')}</h3>
        <div class="people-grid">
          {network.map((p) => <PersonCard person={p} lang={lang} />)}
        </div>
      </div>
    </section>

    <section class="section" id="work" aria-labelledby="work-title">
      <div class="container">
        <div class="section-head">
          <h2 id="work-title" set:html={t('Selected <em>work</em>')} />
          <p>{t('Filter by service to see everything the network has shipped in that area.')}</p>
        </div>

        <div class="filters" role="group" aria-label={t('Filter work by service')}>
          <button type="button" data-filter="all" aria-pressed="true">{t('All')}</button>
          {
            services
              .filter((s) => s.projectCount > 0)
              .map((s) => (
                <button type="button" data-filter={s.id} aria-pressed="false">
                  {s.short}
                </button>
              ))
          }
        </div>

        <div class="work-grid">
          {
            work.map((p) => {
              const href = p.url ?? p.caseStudy;
              const tile = p.client ?? p.name;
              return (
                <article
                  class="work"
                  data-services={p.services.join(' ')}
                  data-featured={p.featured ? 'true' : 'false'}
                  hidden={!p.featured}
                >
                  <div class="work__thumb" style={`--hue:${hue(p.en.client ?? p.en.name)}`}>
                    {p.image ? <img src={asset(p.image)} alt="" loading="lazy" /> : <span class="work__mono">{tile}</span>}
                  </div>
                  <div class="work__body">
                    <p class="work__meta">{[p.type, p.sector].filter(Boolean).join(' · ')}</p>
                    <h3>
                      {href ? (
                        <a href={href} target="_blank" rel="noopener noreferrer">
                          {p.name}
                          <span aria-hidden="true"> ↗</span>
                        </a>
                      ) : (
                        p.name
                      )}
                    </h3>
                    <p class="work__summary">{p.summary}</p>
                    <p class="work__by">
                      {t('by')} <a href={`#${p.person.id}`}>{p.person.data.name}</a>
                    </p>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <p><strong>{site.name}</strong> · {site.city}</p>
      <p>{t("Project credits come from each person's own portfolio and profiles.")}</p>
    </div>
  </footer>
</Base>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.work')];

  function applyFilter(filter: string) {
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
    for (const c of cards) {
      const services = (c.dataset.services ?? '').split(' ');
      c.hidden = filter === 'all' ? c.dataset.featured !== 'true' : !services.includes(filter);
    }
  }

  for (const b of buttons) b.addEventListener('click', () => applyFilter(b.dataset.filter!));

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-goto-filter]')) {
    link.addEventListener('click', () => applyFilter(link.dataset.gotoFilter!));
  }
</script>
