---
// Potent, a portfolio-style agency blueprint for an investor, in both languages: "/" renders
// this file as is (English) and src/pages/ru/index.astro renders it with lang="ru".
// The story: the film and the big names, proof, everything digital a business needs (outside,
// inside, from above, each step with the projects where we have done it: src/data/journey.ts),
// all the work as a compact grid, the team, how the team is built, how a project runs, the
// market and how we make money, the plan (agency now, scale next, the academy after scale),
// and the next step. Text goes through t() (Russian in src/i18n/ru.ts); numbers and their
// sources live in src/data/blueprint.ts, the work's order in src/data/showcase.ts.
import { getCollection } from 'astro:content';
import ArtLoop from '../components/ArtLoop.astro';
import Base from '../layouts/Base.astro';
import Build from '../components/Build.astro';
import Engine from '../components/Engine.astro';
import Flow from '../components/Flow.astro';
import PersonCard from '../components/PersonCard.astro';
import Journey from '../components/Journey.astro';
import Work from '../components/Work.astro';
import { CONTACTS, MARKET, NETWORK, PRICES, PROCESS, PROOF, STREAMS, STRUCTURE } from '../data/blueprint';
import { CASES, MORE } from '../data/showcase';
import { AREAS, SERVICES } from '../data/services';
import { SITE } from '../data/site';
import {
  LANGS,
  LANG_LABELS,
  homePath,
  localPerson,
  localSite,
  projectCount,
  translator,
  type Lang,
  type LocalPerson,
} from '../i18n';
import { asset, keep } from '../lib/util';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = translator(lang);
const site = localSite(lang);

const ruTexts = new Map(lang === 'ru' ? (await getCollection('peopleRu')).map((e) => [e.id, e.data]) : []);
const people = (await getCollection('people'))
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name))
  .map((p) => localPerson(p, ruTexts.get(p.id)));
const founders = people.filter((p) => p.data.group === 'founder');
const areaRank = (p: LocalPerson) => {
  const area = SERVICES.find((s) => s.id === p.data.services[0])?.area;
  const i = AREAS.findIndex((a) => a.id === area);
  return i === -1 ? AREAS.length : i;
};
// Faces first, then by area; people without a photo yet come last.
const specialists = people
  .filter((p) => p.data.group === 'network')
  .sort((a, b) => Number(!a.data.photo) - Number(!b.data.photo) || areaRank(a) - areaRank(b));

// The big names on the first screen must be real clients in someone's file.
const clients = new Set(people.flatMap((p) => p.data.projects.map((pr) => pr.en.client).filter(Boolean)));
for (const b of SITE.brands) {
  if (!clients.has(b)) throw new Error(`src/data/site.ts: "${b}" is in brands, but no project in src/content/people/ has it as client.`);
}

// The two heads of the team structure, with their faces.
const heads = STRUCTURE.heads.map((h) => {
  const p = founders.find((f) => f.id === h.person);
  if (!p) throw new Error(`src/data/blueprint.ts: STRUCTURE names "${h.person}", who is not a founder.`);
  return { id: p.id, name: p.data.name, role: h.role, photo: p.data.photo ? asset(p.data.photo) : null };
});

const academy = founders.flatMap((p) => p.data.projects).find((p) => p.en.name === '101SPOT');
const [first, second] = founders.map((p) => p.data.name.split(' ')[0]);
const external = { target: '_blank', rel: 'noopener noreferrer' };
const REEL = asset('/hero/reel.mp4');
---

<Base lang={lang} title={t('{name}: we make businesses run themselves.', { name: site.name })}>
  <header class="site-header" data-header>
    <div class="wide">
      <a class="wordmark" href="#top"><i aria-hidden="true"></i>{site.name}</a>
      <nav class="nav" aria-label={t('Sections')}>
        <a href="#work">{t('Work')}</a>
        <a href="#team">{t('Team')}</a>
        <a href="#market">{t('Market')}</a>
        <a href="#plan">{t('Plan')}</a>
      </nav>
      <a class="nav-plan" href="#plan">{t('Plan')} <span aria-hidden="true">↓</span></a>
      <ul class="lang" aria-label={t('Language')}>
        {
          LANGS.map((l) => (
            <li>
              {l === lang ? (
                <span aria-current="true">{LANG_LABELS[l]}</span>
              ) : (
                <a href={homePath(l)} hreflang={l} lang={l}>
                  {LANG_LABELS[l]}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </header>

  <main id="top">
    <!-- Big screens: a still from Luka's reel fills the first screen, and the reel itself fades in
         over it. Phones: his film "One Point", cut to a loop without words (scripts/hero-phone.sh),
         plays in the space above the headline; the picture is that loop's first frame. Both are
         started by the script at the end of this file. -->
    <section class="hero">
      <div class="hero__art">
        <div class="hero__stage">
          <picture class="hero__still">
            <source media="(max-width: 699px) and (min-height: 501px)" srcset={asset('/hero/one-point-phone.webp')} />
            <img src={asset('/hd/reel-still.webp')} alt="" fetchpriority="high" decoding="async" />
          </picture>
          <video
            class="hero__loop"
            data-loop={asset('/hero/one-point-phone.mp4')}
            muted
            loop
            playsinline
            preload="none"
            disablepictureinpicture
            disableremoteplayback
            aria-hidden="true"
            tabindex="-1"></video>
        </div>
      </div>
      <video class="hero__film" data-film={REEL} muted playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
      <div class="hero__shade" aria-hidden="true"></div>
      <div class="wide hero__content">
        <p class="eyebrow">{site.tagline}</p>
        <h1>
          <span>{t('We make businesses run themselves.')}</span>{' '}
          <em><a href="#scope">{t("Here's how.")}</a></em>
        </h1>
        <div class="hero__brands">
          <p class="eyebrow" id="brands-title">{t('Our people have worked for')}</p>
          <ul role="list" aria-labelledby="brands-title">
            {SITE.brands.map((b) => <li>{b}</li>)}
          </ul>
        </div>
        <div class="hero__foot">
          <span class="hero__credit">
            {t('Film by co-founder Luka Skhiladze')}
            <button class="hero__toggle" type="button" aria-pressed="false" aria-label={t('Pause the film')} hidden></button>
          </span>
          <a href="#proof">{t('Scroll')} <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </section>

    <section class="proof-band" id="proof" aria-labelledby="proof-title">
      <div class="wide">
        <p class="manifesto" id="proof-title" data-reveal>
          {keep(t('Four of us have built products for Bank of Georgia. Two are CTOs of other companies.'))}
        </p>
        <ul class="proof" role="list">
          {
            PROOF.map((p) => (
              <li class="proof__item" data-reveal>
                <span class="proof__value">{t(p.value)}</span>
                <span class="proof__label">
                  {keep(t(p.label))}{' '}
                  {p.source && (
                    <a class="source" href={p.source.url} {...external}>
                      {t('Source')}: {p.source.name}
                    </a>
                  )}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Journey lang={lang} people={people} />

    <section class="block" id="work" aria-labelledby="work-title">
      <div class="wide">
        <header class="block-head" data-reveal>
          <h2 id="work-title">{t('Selected work')}</h2>
          <p class="block-head__count">{projectCount(lang, CASES.length + MORE.length)}</p>
        </header>
        <Work people={people} lang={lang} compact />
      </div>
    </section>

    <section class="block" id="team" aria-labelledby="team-title">
      <div class="wide">
        <header class="block-head" data-reveal>
          <h2 id="team-title" set:html={t("Senior people who've done it for <em>big names.</em>")} />
        </header>

        <h3 class="kicker">{t('Founders')}</h3>
        <div class="founders">
          {founders.map((p) => <PersonCard person={p} lang={lang} />)}
        </div>

        <h3 class="kicker">{t('Specialists')} <span>{specialists.length}</span></h3>
        <div class="members">
          {specialists.map((p) => <PersonCard person={p} lang={lang} />)}
          <article class="member" data-reveal>
            <img class="avatar avatar--md" src={asset(NETWORK.photo)} alt="" width="56" height="56" loading="lazy" decoding="async" />
            <div class="member__who">
              <h4 class="member__name">
                {NETWORK.groups.map((g) => <span>{t(g, { n: NETWORK.n })}</span>)}
              </h4>
              <p class="member__role">{t('From our network in Tbilisi')}</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="block" id="structure" aria-labelledby="structure-title">
      <div class="wide">
        <header class="block-head" data-reveal>
          <h2 id="structure-title" set:html={t('Every order goes <em>through {a} and {b}.</em>', { a: first!, b: second! })} />
          <p class="block-head__text">
            {t('Two directors, a network of specialists, and partner teams when there is a lot of work. This is the path of one order.')}
          </p>
        </header>
        <div data-reveal>
          <Flow lang={lang} heads={heads} specialists={specialists} more={NETWORK.n * NETWORK.groups.length} sales={STRUCTURE.sales} />
        </div>
      </div>
    </section>

    <section class="block" id="process" aria-labelledby="process-title">
      <div class="wide">
        <header class="block-head" data-reveal>
          <h2 id="process-title" set:html={t('How a project <em>runs.</em>')} />
        </header>
        <ol class="process" role="list" tabindex="0" aria-labelledby="process-title">
          {
            PROCESS.map((step, i) => (
              <li class="process__step" data-reveal>
                {step.pic && (
                  <ArtLoop
                    name={`step-${step.pic}`}
                    lang={lang}
                    widths={[480, 960]}
                    ratio={[1, 1]}
                    sizes="(min-width: 1440px) 256px, (min-width: 1000px) 18vw, min(74vw, 300px)"
                    class="process__pic"
                  />
                )}
                <span class="process__n" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="process__title">{t(step.title)}</h3>
                <p class="process__text">{t(step.text)}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="block" id="market" aria-labelledby="market-title">
      <div class="wide">
        <header class="block-head" data-reveal>
          <h2 id="market-title" set:html={t('Every business pays for digital. <em>More every year.</em>')} />
        </header>
        <ArtLoop
          name="market"
          lang={lang}
          widths={[960, 1920]}
          ratio={[16, 9]}
          sizes="(min-width: 1440px) 1360px, (min-width: 700px) 94vw, 100vw"
          class="market__art"
        />
        <h3 class="kicker">{t('What one project costs a business')}</h3>
        <ol class="prices" role="list">
          {
            PRICES.map((p) => (
              <li class="price" data-reveal>
                <img
                  class="price__pic"
                  src={asset(`/scope/${p.pic}.webp`)}
                  alt=""
                  width="640"
                  height="480"
                  loading="lazy"
                  decoding="async"
                />
                <span class="price__title">{t(p.title)}</span>
                <span class="price__value">{t(p.value)}</span>
                <span class="price__note">{t(p.note)}</span>
              </li>
            ))
          }
        </ol>
        <p class="prices__about">{t('Prices of projects clients reviewed on Clutch, worldwide, 2026.')}</p>

        <h3 class="kicker">{t('Why now')}</h3>
        <dl class="whynow">
          {
            MARKET.map((m) => (
              <div class="whynow__cell" data-reveal>
                <dt>
                  {keep(t(m.label))}{' '}
                  <a class="source" href={m.source.url} {...external}>
                    {t('Source')}: {m.source.name}
                  </a>
                </dt>
                <dd>{t(m.value)}</dd>
              </div>
            ))
          }
        </dl>

        <h3 class="kicker">{t('How we make money')}</h3>
        <ol class="streams" role="list">
          {
            STREAMS.map((s, i) => (
              <li class="stream" data-reveal>
                <span class="stream__n" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="stream__title">
                  {t(s.title)}
                  {s.later && <span class="tag">{t('After scale')}</span>}
                </span>
                <span class="stream__text">{t(s.text)}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="block" id="plan" aria-labelledby="plan-title">
      <div class="wide">
        <header class="block-head" data-reveal>
          <h2 id="plan-title" set:html={t('Agency first. <em>Academy after scale.</em>')} />
        </header>
        <Build lang={lang} />

        <h3 class="kicker">{t('After scale: the academy')}</h3>
        <p class="block-head__text phase__lead" data-reveal>
          {t('Seniors will lead, academy graduates will do the volume: more projects with the same team, and a higher margin.')}
        </p>
        <div class="engine">
          {
            academy && (
              <a class="academy" href={academy.url ?? academy.caseStudy} {...external} data-reveal>
                <img
                  src={asset('/hd/101spot-1200.webp')}
                  srcset={`${asset('/hd/101spot-1200.webp')} 1200w, ${asset('/hd/101spot-1600.webp')} 1600w, ${asset('/hd/101spot-2400.webp')} 2400w`}
                  sizes="(min-width: 1440px) 750px, (min-width: 1000px) 53vw, (min-width: 534px) 94vw, calc(100vw - 32px)"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span class="academy__text">
                  <span class="academy__name">
                    101SPOT <span aria-hidden="true">↗</span>
                  </span>
                  <span>{t('Academy co-founded by Giorgi Kheladze')}</span>
                  <span>
                    <b>{t('90 days')}</b> {t('from junior to mid-level designer')}
                  </span>
                </span>
              </a>
            )
          }
          <div data-reveal><Engine lang={lang} /></div>
        </div>
      </div>
    </section>

    <section class="block next" id="next" aria-labelledby="next-title">
      <ArtLoop name="tbilisi" lang={lang} widths={[960, 1920]} ratio={[16, 9]} sizes="100vw" class="next__art" />
      <div class="wide">
        <header class="block-head" data-reveal>
          <h2 id="next-title" set:html={t("Next step: <em>let's talk.</em>")} />
          <p class="block-head__text">{t('{a} and {b} will answer any question.', { a: first!, b: second! })}</p>
        </header>
        <ul class="next__people" role="list" data-reveal>
          {
            founders.map((p) => (
              <li>
                <a href={`#${p.id}`}>
                  {p.data.photo && <img src={asset(p.data.photo)} alt="" width="72" height="72" loading="lazy" decoding="async" />}
                  <span>
                    <b>{p.data.name}</b>
                    {t('Co-founder')}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        {
          CONTACTS.length > 0 && (
            <ul class="next__actions" role="list" data-reveal>
              {CONTACTS.map((c) => (
                <li>
                  <a href={c.href} {...external}>
                    {t(c.label)}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wide">
      <p class="site-footer__mark" aria-hidden="true">{site.name}</p>
      <div class="site-footer__row">
        <p>{site.name} · {site.city}</p>
        <p>{t("Project credits come from each person's own portfolio and profiles.")}</p>
      </div>
    </div>
  </footer>
</Base>

<script>
  // The header gets a backdrop once the page scrolls.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.toggleAttribute('data-solid', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // The first screen has two films, and a screen shows one of them at most. Big screens: Luka's
  // reel, behind everything. Phones held upright: his film "One Point", cut to a loop without
  // words, above the headline. Neither plays with data saver or reduced motion, or on a phone
  // lying on its side: there the still stays. One button stops and starts whichever is showing.
  const film = document.querySelector<HTMLVideoElement>('[data-film]');
  const loop = document.querySelector<HTMLVideoElement>('[data-loop]');
  const toggle = document.querySelector<HTMLButtonElement>('.hero__toggle');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saver = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const roomy = window.matchMedia('(min-width: 700px) and (min-height: 500px)').matches;
  const upright = window.matchMedia('(max-width: 699px) and (min-height: 501px)');
  let stopped = false;
  const films: (() => void)[] = [];
  toggle?.addEventListener('click', () => {
    stopped = !stopped;
    toggle.setAttribute('aria-pressed', String(stopped));
    for (const startOrRest of films) startOrRest();
  });

  // The reel starts at the still's frame (the aurora) and then loops from the EV film to just
  // before the name card. public/hero/reel.mp4 is that stretch of Luka's reel
  // (skhiladze.com/media/film/reel.mp4, 15.5 s to 52.3 s, cut without re-encoding), so 15.8 s
  // here is 31.3 s in the reel.
  if (film && toggle && !calm && !saver && roomy) {
    const START = 15.8;
    const FROM = 0.1;
    const TO = 36.4;
    let onScreen = true;
    const play = () => film.play().catch(() => {});
    film.src = `${film.dataset.film}#t=${START}`;
    film.addEventListener(
      'playing',
      () => {
        film.classList.add('is-on');
        film.parentElement?.setAttribute('data-film-on', '');
      },
      { once: true },
    );
    film.addEventListener('timeupdate', () => {
      if (film.currentTime >= TO) film.currentTime = FROM;
    });
    film.addEventListener('ended', () => {
      film.currentTime = FROM;
      play();
    });
    play();
    // A way to stop the motion, and a rest while the film is off screen.
    toggle.hidden = false;
    films.push(() => {
      if (stopped || !onScreen) film.pause();
      else play();
    });
    new IntersectionObserver(([e]) => {
      onScreen = Boolean(e?.isIntersecting);
      if (stopped) return;
      if (onScreen) play();
      else film.pause();
    }).observe(film);
  }

  // The loop is fetched only once a phone is held upright, and rests while it is off screen. A
  // phone that will not start a video by itself (Low Power Mode) starts it at the first touch;
  // until then the picture stays, and the button appears only once there is something to stop.
  if (loop && toggle && !calm && !saver) {
    const hero = loop.closest('.hero');
    let ready = false;
    let onScreen = true;
    const play = () => {
      if (ready && !stopped && onScreen && upright.matches) loop.play().catch(() => {});
    };
    const wake = () => {
      if (loop.paused) play();
    };
    const setUp = () => {
      if (ready || !upright.matches) return;
      ready = true;
      loop.muted = true;
      loop.src = loop.dataset.loop!;
      loop.addEventListener(
        'playing',
        () => {
          hero?.setAttribute('data-loop-on', '');
          toggle.hidden = false;
          window.removeEventListener('touchend', wake);
          window.removeEventListener('click', wake);
        },
        { once: true },
      );
      window.addEventListener('touchend', wake, { passive: true });
      window.addEventListener('click', wake);
      films.push(() => {
        if (stopped) loop.pause();
        else play();
      });
      new IntersectionObserver(([e]) => {
        onScreen = Boolean(e?.isIntersecting);
        if (onScreen) play();
        else loop.pause();
      }).observe(loop);
      play();
    };
    // Fetched once the page itself has loaded, so the headline, fonts and still come first.
    if (document.readyState === 'complete') setUp();
    else window.addEventListener('load', setUp, { once: true });
    upright.addEventListener('change', () => {
      setUp();
      if (upright.matches) play();
      else loop.pause();
      // A phone on its side shows neither film, so it has nothing to stop.
      if (!roomy) toggle.hidden = !(upright.matches && hero?.hasAttribute('data-loop-on'));
    });
  }

  // Things rise into place as they come into view.
  const items = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
  if (calm || !('IntersectionObserver' in window)) {
    for (const el of items) el.classList.add('is-in');
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    for (const el of items) io.observe(el);
  }
</script>
