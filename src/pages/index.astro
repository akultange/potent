---
// The investor brief, in both languages: "/" renders this file as is (English) and
// src/pages/ru/index.astro renders it with lang="ru". Three parts: 01 the founders, 02 the
// network (our potential team), 03 what we can make together. Pictures, numbers and names;
// very few words. Text goes through t(): written here in English, looked up in src/i18n/ru.ts.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import Scope from '../components/Scope.astro';
import { AREAS, SERVICES } from '../data/services';
import { SCOPE, SCOPE_WIDTHS } from '../data/scope';
import { SITE } from '../data/site';
import {
  LANGS,
  LANG_LABELS,
  counted,
  homePath,
  localPerson,
  localServices,
  localSite,
  translator,
  type Lang,
  type LocalPerson,
} from '../i18n';
import { asset, hue, initials } from '../lib/util';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = translator(lang);
const site = localSite(lang);

const ruTexts = new Map(lang === 'ru' ? (await getCollection('peopleRu')).map((e) => [e.id, e.data]) : []);
const people = (await getCollection('people'))
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name))
  .map((p) => localPerson(p, ruTexts.get(p.id)));
const founders = people.filter((p) => p.data.group === 'founder');
const network = people.filter((p) => p.data.group === 'network');

// The network as a potential team: each person sits under the area of their main (first)
// service. Anyone without a service still shows up, under "More specialists".
const areaOf = (p: LocalPerson) => SERVICES.find((s) => s.id === p.data.services[0])?.area;
const teams = [
  ...AREAS.map((a) => ({ name: t(a.name), people: network.filter((p) => areaOf(p) === a.id) })),
  { name: t('More specialists'), people: network.filter((p) => !areaOf(p)) },
].filter((team) => team.people.length > 0);

// The best-known clients behind featured work, at most eight, so the line stays short.
const rank = (c: string) => {
  const i = SITE.clientOrder.indexOf(c);
  return i === -1 ? SITE.clientOrder.length : i;
};
const clients = [
  ...new Set(people.flatMap((p) => p.data.projects.filter((pr) => pr.featured && pr.en.client).map((pr) => pr.en.client!))),
]
  .sort((a, b) => rank(a) - rank(b))
  .slice(0, 8);

// Who does what: the founders, then the network in team order.
const services = localServices(lang).filter((s) => people.some((p) => (p.data.services as string[]).includes(s.id)));
const coverage = [
  { name: t('Founders'), people: founders },
  { name: t('Network'), people: teams.flatMap((team) => team.people) },
]
  .map((g) => ({ ...g, people: g.people.filter((p) => p.data.services.length > 0) }))
  .filter((g) => g.people.length > 0);

const stills = SCOPE.slice(0, 4).map((s) => asset(`/scope/${s.id}-${SCOPE_WIDTHS[s.size][0]}.webp`));
const stats = [
  { href: '#founders', num: '01', count: founders.length, unit: counted(lang, founders.length, 'founders'), faces: founders },
  { href: '#network', num: '02', count: network.length, unit: counted(lang, network.length, 'specialists'), faces: network },
  { href: '#scope', num: '03', count: SCOPE.length, unit: counted(lang, SCOPE.length, 'services'), faces: [] as LocalPerson[] },
];
---

<Base lang={lang}>
  <header class="site-header">
    <div class="container">
      <a class="wordmark" href="#top"><i aria-hidden="true"></i>{site.name}</a>
      <nav class="nav" aria-label={t('Sections')}>
        <a href="#founders">{t('Founders')}</a>
        <a href="#network">{t('Network')}</a>
        <a href="#scope">{t('Services')}</a>
      </nav>
      <ul class="lang" aria-label={t('Language')}>
        {
          LANGS.map((l) => (
            <li>
              {l === lang ? (
                <span aria-current="true">{LANG_LABELS[l]}</span>
              ) : (
                <a href={homePath(l)} hreflang={l} lang={l}>
                  {LANG_LABELS[l]}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="container">
        <p class="eyebrow">{t('Investor brief · {city}', { city: site.city })}</p>
        <h1>
          <span>{t('Two founders.')}</span>
          <span>{t('A senior network.')}</span>
          <em>{t('Everything digital.')}</em>
        </h1>

        <ul class="stats">
          {
            stats.map((s) => (
              <li>
                <a class="stat" href={s.href}>
                  <span class="stat__num">{s.num}</span>
                  <span class="stat__count">{s.count}</span>
                  <span class="stat__unit">{s.unit}</span>
                  <span class="stat__visual" aria-hidden="true">
                    {s.faces.length > 0
                      ? s.faces.map((p) => (
                          <span class="avatar avatar--sm" style={`--hue:${hue(p.data.en.name)}`}>
                            {initials(p.data.name)}
                          </span>
                        ))
                      : stills.map((src) => <img class="stat__still" src={src} alt="" />)}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        {
          clients.length > 0 && (
            <div class="clients">
              <p class="label">{t('Our people have worked for')}</p>
              <ul>
                {clients.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    <section class="section" id="founders" aria-labelledby="founders-title">
      <div class="container">
        <header class="chapter-head">
          <p class="chapter"><span>01</span>{t('Founders')}</p>
          <h2 id="founders-title" set:html={t("Managers who've done <em>every part</em> of the work")} />
        </header>
        <div class="founders">
          {founders.map((p) => <PersonCard person={p} lang={lang} />)}
        </div>
      </div>
    </section>

    <section class="section" id="network" aria-labelledby="network-title">
      <div class="container">
        <header class="chapter-head">
          <p class="chapter"><span>02</span>{t('Network')}</p>
          <h2 id="network-title" set:html={t('Our potential <em>team</em>')} />
        </header>
        <div class="teams">
          {
            teams.map((team) => (
              <section class="team" aria-label={team.name}>
                <h3 class="team__name">
                  {team.name} <span>{team.people.length}</span>
                </h3>
                <div class="team__people">
                  {team.people.map((p) => (
                    <PersonCard person={p} lang={lang} level={4} />
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </section>

    <Scope lang={lang} people={people} number="03" />

    <section class="section section--continued" id="who-does-what" aria-labelledby="matrix-title">
      <div class="container">
        <header class="chapter-head">
          <h2 id="matrix-title" set:html={t('Who does <em>what</em>')} />
        </header>
        <div class="matrix-wrap" tabindex="0" role="region" aria-labelledby="matrix-title">
          <table class="matrix">
            <thead>
              <tr>
                <th scope="col" class="matrix__corner"><span class="sr-only">{t('Person')}</span></th>
                {services.map((s) => <th scope="col">{s.short}</th>)}
              </tr>
            </thead>
            {
              coverage.map((g) => (
                <tbody>
                  <tr class="matrix__group">
                    <th scope="rowgroup" colspan={services.length + 1}>
                      <span>{g.name}</span>
                    </th>
                  </tr>
                  {g.people.map((p) => (
                    <tr>
                      <th scope="row">
                        <a href={`#${p.id}`}>
                          <span class="avatar avatar--xs" style={`--hue:${hue(p.data.en.name)}`} aria-hidden="true">
                            {initials(p.data.name)}
                          </span>
                          {p.data.name}
                        </a>
                      </th>
                      {services.map((s) =>
                        (p.data.services as string[]).includes(s.id) ? (
                          <td>
                            <span class="dot" role="img" aria-label={t('Yes')} />
                          </td>
                        ) : (
                          <td>
                            <span class="sr-only">{t('No')}</span>
                          </td>
                        ),
                      )}
                    </tr>
                  ))}
                </tbody>
              ))
            }
          </table>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <p><strong>{site.name}</strong> · {site.city}</p>
      <p>{t("Project credits come from each person's own portfolio and profiles.")}</p>
    </div>
  </footer>
</Base>
