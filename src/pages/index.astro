---
// The agency blueprint, for an investor, in both languages: "/" renders this file as is
// (English) and src/pages/ru/index.astro renders it with lang="ru". It goes: the promise and
// the work, 01 the market, 02 the team, 03 what we sell, 04 the growth engine (academy and
// podcast), 05 the plan. Text goes through t(): written here in English, looked up in
// src/i18n/ru.ts. Numbers and their sources live in src/data/blueprint.ts.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Engine from '../components/Engine.astro';
import Marquee from '../components/Marquee.astro';
import PersonCard from '../components/PersonCard.astro';
import Scope from '../components/Scope.astro';
import { HIRES, MARKET, PLANS, PROOF, STREAMS } from '../data/blueprint';
import { AREAS, SERVICES } from '../data/services';
import { SITE } from '../data/site';
import { LANGS, LANG_LABELS, homePath, localPerson, localSite, translator, type Lang, type LocalPerson } from '../i18n';
import { thumbOf } from '../lib/util';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = translator(lang);
const site = localSite(lang);

const ruTexts = new Map(lang === 'ru' ? (await getCollection('peopleRu')).map((e) => [e.id, e.data]) : []);
const people = (await getCollection('people'))
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name))
  .map((p) => localPerson(p, ruTexts.get(p.id)));
const founders = people.filter((p) => p.data.group === 'founder');
// Specialists in team order: engineering, product design, brand & motion (by their main service).
const areaRank = (p: LocalPerson) => {
  const area = SERVICES.find((s) => s.id === p.data.services[0])?.area;
  const i = AREAS.findIndex((a) => a.id === area);
  return i === -1 ? AREAS.length : i;
};
const specialists = people.filter((p) => p.data.group === 'network').sort((a, b) => areaRank(a) - areaRank(b));

// The best-known clients behind featured work, at most eight.
const rank = (c: string) => {
  const i = SITE.clientOrder.indexOf(c);
  return i === -1 ? SITE.clientOrder.length : i;
};
const clients = [
  ...new Set(people.flatMap((p) => p.data.projects.filter((pr) => pr.featured && pr.en.client).map((pr) => pr.en.client!))),
]
  .sort((a, b) => rank(a) - rank(b))
  .slice(0, 8);

// The academy is a real project of Giorgi's: its link and picture come from his file.
const academy = founders.flatMap((p) => p.data.projects).find((p) => p.en.name === '101SPOT');

const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<Base lang={lang}>
  <header class="site-header">
    <div class="container">
      <a class="wordmark" href="#top"><i aria-hidden="true"></i>{site.name}</a>
      <nav class="nav" aria-label={t('Sections')}>
        <a href="#market">{t('Market')}</a>
        <a href="#team">{t('Team')}</a>
        <a href="#scope">{t('Services')}</a>
        <a href="#plan">{t('Plan')}</a>
      </nav>
      <ul class="lang" aria-label={t('Language')}>
        {
          LANGS.map((l) => (
            <li>
              {l === lang ? (
                <span aria-current="true">{LANG_LABELS[l]}</span>
              ) : (
                <a href={homePath(l)} hreflang={l} lang={l}>
                  {LANG_LABELS[l]}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="container">
        <p class="eyebrow">{t('Agency blueprint · {city}', { city: site.city })}</p>
        <h1>
          <span>{t('Big money is in digital.')}</span>
          <span>{t('We know how to earn it.')}</span>
          <em>{t("Here's the plan.")}</em>
        </h1>
      </div>

      <Marquee people={people} lang={lang} />

      <div class="container">
        <ul class="proof">
          {
            PROOF.map((p) => (
              <li class="proof__item">
                <span class="proof__value">{t(p.value)}</span>
                <span class="proof__label">
                  {t(p.label)}
                  {p.source && (
                    <a class="source" href={p.source.url} {...external}>
                      {p.source.name}
                    </a>
                  )}
                </span>
              </li>
            ))
          }
        </ul>
        {
          clients.length > 0 && (
            <div class="clients">
              <p class="label">{t('Our people have worked for')}</p>
              <ul>
                {clients.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    <section class="section" id="market" aria-labelledby="market-title">
      <div class="container">
        <header class="chapter-head">
          <p class="chapter"><span>01</span>{t('The market')}</p>
          <h2 id="market-title" set:html={t('Every business pays for digital. <em>Every year.</em>')} />
        </header>
        <ul class="money">
          {
            MARKET.map((m) => (
              <li class="money__card">
                <span class="money__value">{t(m.value)}</span>
                <span class="money__label">{t(m.label)}</span>
                <a class="source" href={m.source.url} {...external}>
                  {t('Source')}: {m.source.name}
                </a>
              </li>
            ))
          }
        </ul>

        <h3 class="sub-head">{t('How an agency earns')}</h3>
        <ul class="streams">
          {
            STREAMS.map((s) => (
              <li class="stream">
                <svg class="stream__icon" viewBox="0 0 48 48" aria-hidden="true">
                  {s.id === 'projects' && (
                    <>
                      <rect x="6" y="9" width="36" height="26" rx="3" />
                      <path d="M6 16h36M17 41h14M24 35v6" />
                    </>
                  )}
                  {s.id === 'support' && (
                    <>
                      <path d="M38 20a15 15 0 0 0-27-5M10 28a15 15 0 0 0 27 5" />
                      <path d="M11 7v8h8M37 41v-8h-8" />
                    </>
                  )}
                  {s.id === 'academy' && (
                    <>
                      <path d="M4 18 24 9l20 9-20 9z" />
                      <path d="M12 22v10c0 3 5.5 6 12 6s12-3 12-6V22M44 18v12" />
                    </>
                  )}
                  {s.id === 'podcast' && (
                    <>
                      <rect x="17" y="5" width="14" height="24" rx="7" />
                      <path d="M10 22a14 14 0 0 0 28 0M24 36v7M17 43h14" />
                    </>
                  )}
                </svg>
                <h4>{t(s.title)}</h4>
                <p>{t(s.text)}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" id="team" aria-labelledby="team-title">
      <div class="container">
        <header class="chapter-head">
          <p class="chapter"><span>02</span>{t('The team')}</p>
          <h2 id="team-title" set:html={t("Senior people who've done it for <em>big names.</em>")} />
        </header>

        <h3 class="group-title">{t('Founders')}</h3>
        <div class="founders">
          {founders.map((p) => <PersonCard person={p} lang={lang} />)}
        </div>

        <h3 class="group-title">{t('Specialists')} <span>{specialists.length}</span></h3>
        <div class="members">
          {specialists.map((p) => <PersonCard person={p} lang={lang} />)}
        </div>

        <h3 class="group-title">{t('Next hires, with the investment')}</h3>
        <ul class="hires">
          {
            HIRES.map((h) => (
              <li class="hire">
                <span aria-hidden="true">+</span>
                {t(h)}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Scope lang={lang} people={people} number="03" label={t('What we sell')} compact />

    <section class="section" id="engine" aria-labelledby="engine-title">
      <div class="container engine">
        <div class="engine__text">
          <header class="chapter-head">
            <p class="chapter"><span>04</span>{t('Growth engine')}</p>
            <h2 id="engine-title" set:html={t('Our own academy grows <em>our own people.</em>')} />
          </header>
          <p class="engine__lede">
            {t('Seniors lead, academy graduates do the volume: more projects with the same team, and a higher margin.')}
          </p>
          {
            academy && (
              <a class="academy" href={academy.url ?? academy.caseStudy} {...external}>
                {academy.image && <img src={thumbOf(academy.image)} alt="" width="640" height="400" loading="lazy" />}
                <span class="academy__text">
                  <span class="academy__name">
                    101SPOT <span aria-hidden="true">↗</span>
                  </span>
                  <span class="academy__by">{t('Academy co-founded by Giorgi Kheladze')}</span>
                  <span class="academy__fact">
                    <b>{t('90 days')}</b> {t('from junior to mid-level designer')}
                  </span>
                </span>
              </a>
            )
          }
        </div>
        <Engine lang={lang} />
      </div>
    </section>

    <section class="section" id="plan" aria-labelledby="plan-title">
      <div class="container">
        <header class="chapter-head">
          <p class="chapter"><span>05</span>{t('The plan')}</p>
          <h2 id="plan-title" set:html={t('$100,000 to build it <em>faster.</em>')} />
        </header>
        <div class="plans">
          {
            PLANS.map((p) => (
              <article class:list={['plan', { 'plan--pick': p.recommended }]}>
                {p.recommended && <p class="plan__badge">{t('Recommended')}</p>}
                <p class="plan__amount">{t(p.amount)}</p>
                <h3 class="plan__name">{t(p.name)}</h3>
                <ul class="plan__points">
                  {p.points.map((point) => (
                    <li>{t(point)}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <p><strong>{site.name}</strong> · {site.city}</p>
      <p>{t("Project credits come from each person's own portfolio and profiles.")}</p>
    </div>
  </footer>
</Base>
